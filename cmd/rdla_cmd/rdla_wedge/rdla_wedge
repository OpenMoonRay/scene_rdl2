# Maps RDL2 attribute type names that --wedge-attribute can sensibly animate
# to (Lua constructor name or None for a bare numeric scalar, expected
# component count). Any attribute type not listed here (e.g. Bool, String,
# SceneObject, *Vector, Mat3/Mat4, Vec4) is rejected rather than silently
# producing a nonsensical or malformed sidecar expression.
WEDGEABLE_ATTR_TYPES = {
    'Float':  (None, 1),
    'Double': (None, 1),
    'Int':    (None, 1),
    'Long':   (None, 1),
    'Vec2f':  ('Vec2', 2),
    'Vec2d':  ('Vec2', 2),
    'Vec3f':  ('Vec3', 3),
    'Vec3d':  ('Vec3', 3),
    'Rgb':    ('Rgb', 3),
    'Rgba':   ('Rgba', 4),
}

def linstep(inmin, inmax, outmin, outmax, time, power):
    t = pow((float(time) - float(inmin)) / (float(inmax) - float(inmin)), power)
    if t < 0: t = 0
    if t > 1: t = 1
    return outmin + t * (outmax - outmin)

def pingpong(startFrame, endFrame, minVal, maxVal, time, power):
    midFrame = endFrame / 2.0
    if time <= midFrame:
        # First half: go from minVal to maxVal
        return linstep(startFrame, midFrame, minVal, maxVal, time, power)
    else:
        # Second half: go from maxVal back to minVal
        return linstep(midFrame, endFrame, maxVal, minVal, time, power)

def animate(startFrame, endFrame, minVal, maxVal, time, power, usePingpong):
    if usePingpong:
        return pingpong(startFrame, endFrame, minVal, maxVal, time, power)
    else:
        outVal = minVal + \
            linstep(startFrame, endFrame, 0, maxVal - minVal, time, power)
        return outVal

def runCmd(textCmd, useShell):
    p = subprocess.Popen(textCmd,
                         stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE,
                         shell=useShell)

    (tmpStdOut, tmpStdErr) = p.communicate()

    if p.returncode and p.returncode != 0:
        printError('cmd failed with return code: ', p.returncode)
        print('cmd = %s' % (' '.join(textCmd)))
        print('stdout = %s' % tmpStdOut)
        print('stderr = %s' % tmpStdErr)
        return False
    else:
        return True

def runCmdWithOutput(textCmd, useShell):
    """Run command and return (success, stdout, stderr)"""
    p = subprocess.Popen(textCmd,
                         stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE,
                         shell=useShell)

    (tmpStdOut, tmpStdErr) = p.communicate()

    if p.returncode and p.returncode != 0:
        printError('cmd failed with return code: ', p.returncode)
        print('cmd = %s' % (' '.join(textCmd)))
        print('stdout = %s' % tmpStdOut)
        print('stderr = %s' % tmpStdErr)
        return (False, tmpStdOut, tmpStdErr)
    else:
        return (True, tmpStdOut, tmpStdErr)


def getImageHeight(inputFile):
    """Query image height via oiiotool --info. Returns None if it can't be determined."""
    infoCmd = ['oiiotool', '--info', inputFile]
    success, stdout, stderr = runCmdWithOutput(infoCmd, False)
    if not success:
        return None
    output = stdout.decode('utf-8') if isinstance(stdout, bytes) else stdout
    # oiiotool --info prints e.g. "foo.exr : 1920 x 1080, 4 channel, ..."
    match = re.search(r':\s*\d+\s*x\s*(\d+)', output)
    if match:
        return int(match.group(1))
    return None

def overlayTextCmd(inputFile,
                   textColor,
                   textSize,
                   label,
                   value,
                   vertOffset,
                   verbose,
                   position,
                   outputFile,
                   imgHeight):

    # Calculate y position based on position (top or bottom)
    # oiiotool measures y from top of image
    # Add base offset so text isn't at the very edge
    if position == 'top':
        # Use text size as base offset so text position scales with text size
        y_pos = textSize + int(vertOffset)
    else:
        # Bottom positioning needs the actual image height
        if imgHeight is None:
            printError('Could not determine image height for text overlay positioning: ', inputFile)
            return False
        y_pos = imgHeight - textSize - int(vertOffset)

    x_pos = 8

    # Convert common color names to RGB values for oiiotool
    colorMap = {
        'white': '1,1,1',
        'black': '0,0,0',
        'red': '1,0,0',
        'green': '0,1,0',
        'blue': '0,0,1',
        'yellow': '1,1,0',
        'cyan': '0,1,1',
        'magenta': '1,0,1'
    }

    colorValue = colorMap.get(textColor.lower(), '1,1,1')  # default to white

    # Build text option with all modifiers
    textOption = '--text:x=%d:y=%d:size=%d:color=%s' % (x_pos, y_pos, textSize, colorValue)
    textContent = '%s=%s' % (label, value)

    textCmd = ['oiiotool',
               '-i', inputFile,
               textOption,
               textContent,
               '-o', outputFile]

    if verbose:
        print('\t' + ' '.join(textCmd))

    return runCmd(textCmd, False)

def convert_exr_to_png_with_alpha(args):
    """Helper function for parallel EXR to PNG conversion with alpha handling"""
    imgFile, pngFile, verbose = args

    # Use oiiotool to composite over black background and convert colorspace
    # Create black RGBA image using same geometry as input, then composite
    # Limit threads to 1 since we're running multiple processes in parallel
    oiioCmd = ['oiiotool',
               '--threads', '1',  # Use single thread per process
               imgFile,
               '--create', '{TOP.width}x{TOP.height}', '4',  # Create black RGBA image
               '--swap',
               '--over',  # Composite image over black background
               '--ch', 'R,G,B',  # Keep only RGB channels
               '--iscolorspace', 'linear',
               '--tocolorspace', 'sRGB',
               '-o', pngFile]

    if verbose:
        print('\t' + ' '.join(oiioCmd))

    return runCmd(oiioCmd, False)

def render_single_frame(args):
    """Helper function for parallel frame rendering"""
    (frameNumber, tmpRdlaFiles, outputFile, exec_mode, verbose,
     apply_text, text_params, show_mcrt, show_frame_number, show_attribute,
     has_attribute_animation, wedge_value) = args

    # Render the frame - add all rdla files with -in flags
    rndrCmd = ['moonray']
    for rdlaFile in tmpRdlaFiles:
        rndrCmd.extend(['-in', rdlaFile])

    # Always inject wedge and frame_num variables
    rndrCmd.extend(['-out', outputFile,
                    '-rdla_set', 'wedge', str(wedge_value),
                    '-rdla_set', 'frame_num', str(frameNumber)])

    rndrCmd.extend(['-exec_mode', exec_mode])

    # Add -info flag if we need MCRT time
    if show_mcrt:
        rndrCmd.insert(1, '-info')

    if verbose:
        print('\tRendering frame %d: %s' % (frameNumber, ' '.join(rndrCmd)))

    startFrameTime = time.time()
    success, stdout, stderr = runCmdWithOutput(rndrCmd, False)
    elapsed = time.time() - startFrameTime

    if not success:
        # moonray may return non-zero when the scene's built-in output path fails
        # but the -out target was still written successfully.  Check the file.
        if os.path.exists(outputFile) and os.path.getsize(outputFile) > 0:
            if verbose:
                print('\tFrame %d: moonray exited non-zero but output file exists; treating as success' % frameNumber)
            success = True
        else:
            print('\tFrame %d FAILED' % frameNumber)
            return (frameNumber, False, outputFile, elapsed)

    # Extract MCRT time if requested
    mcrt_time = None
    if show_mcrt and apply_text:
        # Parse moonray output for "Mcrt time" - check both stdout and stderr
        output = stdout.decode('utf-8') if isinstance(stdout, bytes) else stdout
        output += stderr.decode('utf-8') if isinstance(stderr, bytes) else stderr

        if verbose:
            print('\tSearching for MCRT time in moonray output...')

        for line in output.split('\n'):
            if 'Mcrt time' in line:
                # Extract the time portion after the equals sign
                parts = line.split('=')
                if len(parts) > 1:
                    mcrt_time = parts[1].strip()
                    if verbose:
                        print('\tFound MCRT time: %s' % mcrt_time)
                break

        if not mcrt_time and verbose:
            print('\tMCRT time not found in output')

    # Apply text overlay if requested
    if apply_text:
        success = apply_text_overlay(frameNumber, outputFile, text_params, mcrt_time,
                                     show_frame_number, show_attribute)
        if not success:
            print('\tFrame %d text overlay FAILED' % frameNumber)
            return (frameNumber, False, outputFile, elapsed)

    print('\tFrame %d complete (%.2f seconds) %sWrote:%s %s' %
          (frameNumber, elapsed, bcolors.OKGREEN, bcolors.ENDC, outputFile))
    return (frameNumber, True, outputFile, elapsed)

def evalOverlayExpr(expr, wedge_value, frameNumber):
    """Evaluate a user-supplied overlay expression string.

    The expression is a Python expression (optionally containing a '%' format
    operator, e.g. '"%.3f" % (0.85 + wedge*0.35)') evaluated with 'wedge'
    (the [0,1] wedge value) and 'frame_num' (the integer frame number) in
    scope, plus the 'math' module. Returns the formatted string, or an
    '<error: ...>' placeholder string if evaluation fails (rendering still
    proceeds; a bad expression shouldn't abort the whole wedge).
    """
    import math
    # Only expose a small, safe subset of builtins (arithmetic/formatting
    # helpers) -- not the full builtins module (no open/import/exec/etc).
    builtinsDict = __builtins__ if isinstance(__builtins__, dict) else vars(__builtins__)
    safeBuiltins = {name: builtinsDict.get(name)
                    for name in ('abs', 'min', 'max', 'round', 'pow', 'int', 'float', 'str')}
    try:
        result = eval(expr, {'__builtins__': safeBuiltins, 'math': math},
                      {'wedge': wedge_value, 'frame_num': frameNumber})
        return result if isinstance(result, str) else str(result)
    except Exception as e:
        return '<error: %s>' % e

def apply_text_overlay(frameNumber, outputFile, text_params, mcrt_time=None,
                       show_frame_number=False, show_attribute=True):
    """Apply text overlay to a rendered frame"""
    (workDir, textcolor, textsize, verbose, textposition,
     animatedAttrs, staticAttrSpecs, staticAttrValues, wedge_value, wedge_label, overlay_exprs) = text_params

    tmpOutputFile = '%s/tmp_text_overlay_%04d.exr' % (workDir, frameNumber)

    # Determine the image height once per frame; every overlay line reuses it
    # rather than re-querying oiiotool for an invariant value.
    imgHeight = getImageHeight(outputFile) if textposition != 'top' else None

    # Prefix each attribute's display label with its object name only when
    # more than one *distinct object* (across animated and static attributes
    # combined) is involved, so a single-target wedge keeps the original,
    # less-cluttered "attr=value" look.
    allObjectNames = set(spec['objectName'] for spec in animatedAttrs) | \
                     set(spec['objectName'] for spec in staticAttrSpecs)
    multiObject = len(allObjectNames) > 1

    # Apply MCRT time text first if available
    vertOffset = 0
    currentInput = outputFile
    if mcrt_time:
        if not overlayTextCmd(currentInput, textcolor, textsize, 'Mcrt time', mcrt_time,
                             vertOffset, verbose, textposition, tmpOutputFile, imgHeight):
            return False
        vertOffset += (textsize * 1.5)
        currentInput = tmpOutputFile

    # Apply frame number if requested
    if show_frame_number:
        if not overlayTextCmd(currentInput, textcolor, textsize, 'Frame', str(frameNumber),
                             vertOffset, verbose, textposition, tmpOutputFile, imgHeight):
            return False
        vertOffset += (textsize * 1.5)
        currentInput = tmpOutputFile

    # Apply wedge label if in manual mode and label is provided
    if wedge_label:
        wedge_display = '%.2f' % wedge_value
        if not overlayTextCmd(currentInput, textcolor, textsize, wedge_label, wedge_display,
                             vertOffset, verbose, textposition, tmpOutputFile, imgHeight):
            return False
        vertOffset += (textsize * 1.5)
        currentInput = tmpOutputFile

    # Apply any computed overlay expressions (--overlay-expr "label=expr").
    # Unlike --wedge-label (which always shows the raw [0,1] wedge fraction)
    # or --overlay-wedged-attributes (which requires --wedge-attribute and shows
    # only the literal animated attribute value), this lets the caller show
    # arbitrary derived quantities computed from 'wedge' in manual mode.
    for label, expr in overlay_exprs:
        display = evalOverlayExpr(expr, wedge_value, frameNumber)
        if not overlayTextCmd(currentInput, textcolor, textsize, label, display,
                             vertOffset, verbose, textposition, tmpOutputFile, imgHeight):
            return False
        vertOffset += (textsize * 1.5)
        currentInput = tmpOutputFile

    # Apply main attribute text, one line per animated attribute (only if
    # show_attribute is True and we're in automatic mode)
    if show_attribute:
        for spec in animatedAttrs:
            minVals = spec['minVals']
            maxVals = spec['maxVals']
            multiType = spec['multiType']

            # Use the already-correct wedge_value (exactly what was injected
            # via -rdla_set wedge and baked into the sidecar's Lua formula)
            # rather than independently recomputing via animate()/endFrame,
            # which ignored --inclusive and could drift from the actual
            # rendered value.
            wedgeVals = []
            for i in range(len(minVals)):
                v = minVals[i] + wedge_value * (maxVals[i] - minVals[i])
                wedgeVals.append('%.04f' % v)

            if multiType:
                # Component count was already validated in
                # resolveAnimatedAttributes() to match this type exactly.
                value = '%s(%s)' % (multiType, ', '.join(wedgeVals))
            else:
                value = wedgeVals[0]

            if multiObject:
                label = '%s.%s' % (spec['objectName'], spec['attrName'])
            else:
                label = spec['attrName']

            if not overlayTextCmd(currentInput, textcolor, textsize, label, value,
                                 vertOffset, verbose, textposition, tmpOutputFile, imgHeight):
                return False
            vertOffset += (textsize * 1.5)
            currentInput = tmpOutputFile

    # Apply static attribute text (--overlay-static-attributes). Independent
    # of show_attribute/--overlay-wedged-attributes: shown whenever any were requested,
    # whether or not anything is actually being animated.
    for spec in staticAttrSpecs:
        objectName = spec['objectName']
        for attrName in spec['attrNames']:
            value = staticAttrValues.get((objectName, attrName))
            if value is None:
                continue
            if multiObject:
                label = '%s.%s' % (objectName, attrName)
            else:
                label = attrName
            if not overlayTextCmd(currentInput, textcolor, textsize, label, value,
                                 vertOffset, verbose, textposition, tmpOutputFile, imgHeight):
                return False
            vertOffset += (textsize * 1.5)
            currentInput = tmpOutputFile

    # Only copy back if we actually wrote something
    if currentInput != outputFile:
        shutil.copy(tmpOutputFile, outputFile)
        os.remove(tmpOutputFile)

    return True

class RdlaWedge:
    def parseCommandLine(self):
        """ Parse the command line """

        for i, arg in enumerate(sys.argv):
            if (arg[0] == '-') and arg[1].isdigit(): sys.argv[i] = ' ' + arg

        examplesEpilog = (
            "Examples:\n"
            "  # Manual mode: drive the 'wedge' variable yourself inside the rdla file\n"
            "  rdla_wedge scene.rdla 20 output.gif\n"
            "\n"
            "  # Automatic mode: animate a material's roughness from 0 to 1\n"
            "  rdla_wedge --wedge-attribute MyMaterial roughness 0 1 scene.rdla 20 output.gif\n"
            "\n"
            "  # Animate two different objects' attributes together in the same wedge\n"
            "  rdla_wedge --wedge-attribute GlassLeft refractive_index 1.0 1.5 \\\n"
            "             --wedge-attribute GlassRight refractive_index 1.5 1.0 \\\n"
            "             scene.rdla 30 output.mp4\n"
            "\n"
            "  # Show the animated attribute's name/value as a text overlay on each frame\n"
            "  rdla_wedge --wedge-attribute MyMaterial roughness 0 1 scene.rdla 20 output.mp4 \\\n"
            "             --overlay-wedged-attributes\n"
            "\n"
            "  # Also overlay a couple of other (static) attributes for context\n"
            "  rdla_wedge --wedge-attribute MyMaterial roughness 0 1 scene.rdla 20 output.mp4 \\\n"
            "             --overlay-wedged-attributes --overlay-static-attributes MyMaterial refractive_index,tint\n"
            "\n"
            "  # Overlay static attributes alone, with no attribute being animated at all\n"
            "  rdla_wedge scene.rdla 20 output.mp4 \\\n"
            "             --overlay-static-attributes MyMaterial refractive_index,tint\n"
            "\n"
            "  # Overlay an arbitrary computed value derived from 'wedge' (manual mode)\n"
            "  rdla_wedge scene.rdla 20 output.mp4 \\\n"
            "             --overlay-expr 'ior=\"%.3f\" % (1.0 + wedge * 0.5)'\n"
            "\n"
            "  # Pingpong the animation (min->max->min) and show the MCRT render time\n"
            "  rdla_wedge --wedge-attribute MyMaterial roughness 0 1 scene.rdla 20 output.gif \\\n"
            "             --pingpong --overlay-mcrt\n"
            "\n"
            "  # Output an image sequence instead of a gif/mp4\n"
            "  rdla_wedge --wedge-attribute MyMaterial roughness 0 1 scene.rdla 10 frames/out.*.jpg\n"
            "\n"
            "  # Animate a SceneVariables attribute instead of a material/map attribute\n"
            "  rdla_wedge --inclusive --overlay-wedged-attributes --wedge-attribute sv pixel_samples 1 16 scene.rdla 16 output.mp4\n"
        )

        parser = OptionParser(
                              "usage: %prog [options] <rdla/rdlb file> [rdla/rdlb file2] [...] <frames> <output1> [output2] [...]\n\n" +
                              "Note: Multiple rdla/rdlb files can be specified - later files override/extend earlier ones\n" +
                              "      A global 'wedge' variable (0-1) is always injected via -rdla_set\n" +
                              "      Use --wedge-attribute to also animate a specific attribute (creates sidecar rdla file);\n" +
                              "      repeat --wedge-attribute to animate multiple objects/attributes together\n" +
                              "      Use 'out.*.ext' pattern for image sequence output (e.g., out.*.exr, frames.*.jpg)\n" +
                              "      Multiple outputs can be specified (e.g., out.mp4 frames.*.jpg)",
                              formatter=WideHelpFormatter(),
                              epilog=examplesEpilog)

        parser.add_option("--overlay-wedged-attributes",
                          action="store_true",
                          dest="overlay_wedged_attributes",
                          help="overlay the wedged attribute name(s) and value(s) on the images " +
                               "(one line per --wedge-attribute)")

        parser.add_option("--overlay-mcrt",
                          action="store_true",
                          dest="overlay_mcrt",
                          help="overlay the MCRT render time on the images")

        parser.add_option("--overlay-frame",
                          action="store_true",
                          dest="overlay_frame",
                          help="overlay the frame number on the images")

        parser.add_option("--overlay-static-attributes",
                          dest="overlay_static_attributes",
                          nargs=2,
                          action="append",
                          metavar="OBJECT ATTRS",
                          help="Overlay one or more fixed (non-animated) attribute values as " +
                               "text, for context. Pass two separate arguments: " +
                               "<object-name|sv> <comma,separated,attr,names> " +
                               "(e.g., --overlay-static-attributes MyMaterial albedo,tint). " +
                               "May be specified multiple times to show attributes from " +
                               "multiple objects. Works independently of --wedge-attribute " +
                               "and --overlay-wedged-attributes, in either automatic mode " +
                               "or manual mode.")

        parser.add_option("--power",
                          type="float",
                          default=1.0,
                          help="power to apply to linear attribute interpolation " +
                               "[default: %default]")

        parser.add_option("--textsize",
                          type="int",
                          default=20,
                          help="point size of the text. [default: %default]")

        parser.add_option("--textcolor",
                          default="white",
                          help="name of the color to use for the text overlay " +
                               "(i.e. white, red, black, etc.) [default=%default]")

        parser.add_option("--textposition",
                          default="bottom",
                          help="position of the text overlay: 'top' or 'bottom' [default=%default]")

        parser.add_option("--skiprender",
                          action="store_true",
                          help="Don't render, only convert to gif.  " +
                               "Assumes images are present")

        parser.add_option("--pingpong",
                          action="store_true",
                          help="Pingpong the animation (min->max->min) instead of linear (min->max)")

        parser.add_option("--wedge-attribute",
                          dest="wedge_attribute",
                          nargs=4,
                          action="append",
                          help="Animate a specific attribute or scene variable. " +
                               "Pass four separate arguments: <object-name|sv> <attr> <min> <max> " +
                               "(e.g., --wedge-attribute MyMaterial roughness 0 1). " +
                               "May be specified multiple times to animate multiple " +
                               "objects/attributes together in the same wedge, e.g. " +
                               "--wedge-attribute MatA roughness 0 1 " +
                               "--wedge-attribute MatB refractive_index 1.0 1.5")

        parser.add_option("--inclusive",
                          action="store_true",
                          help="Make wedge range [0,1] instead of [0,1) (includes 1.0 on last frame)")

        parser.add_option("--wedge-label",
                          dest="wedge_label",
                          help="Label for the wedge variable to display as text overlay")

        parser.add_option("--overlay-expr",
                          action="append",
                          dest="overlay_expr",
                          metavar="LABEL=EXPR",
                          help="Overlay a computed value as text, one line per use of this "
                               "option (can be repeated). EXPR is a Python expression "
                               "evaluated with 'wedge' (the [0,1] wedge value) and "
                               "'frame_num' in scope; the 'math' module is also available. "
                               "Unlike --wedge-label (raw wedge fraction only) or "
                               "--overlay-wedged-attributes (requires --wedge-attribute), this "
                               "works in manual mode with any formula, e.g. "
                               "--overlay-expr \"n2=%.3f % (0.85 + wedge*0.35)\"")

        parser.add_option("--exec_mode",
                          type="choice",
                          choices=["scalar", "vector", "xpu", "auto"],
                          default="auto",
                          help="Moonray execution mode: scalar, vector, xpu, or auto (default: auto)")

        parser.add_option("--max-concurrent-jobs",
                          type="int",
                          default=16,
                          help="Maximum number of parallel processes to use for rendering "
                               "frames, and for EXR-to-PNG conversion when producing GIF/MP4 "
                               "output [default: %default]")

        parser.add_option("--no-clean",
                          action="store_false",
                          dest="clean",
                          default=True,
                          help="Don't clean the temp directory before starting (default is to clean)")

        parser.add_option("-v", "--verbose",
                          action="store_true",
                          help="verbose output.  Print the commands being " +
                               "run and timing information")

        sortOptionList(parser)
        (self.mOptions, args) = parser.parse_args()

        # Parse rdla/rdlb files (one or more) - all arguments ending in .rdla or .rdlb
        self.mSourceRdlaFiles = []
        argIndex = 0
        while argIndex < len(args) and (args[argIndex].endswith('.rdla') or args[argIndex].endswith('.rdlb')):
            self.mSourceRdlaFiles.append(args[argIndex])
            argIndex += 1

        if not self.mSourceRdlaFiles:
            parser.error("at least one rdla/rdlb file must be specified (ending in .rdla or .rdlb)")
            return

        # Parse frames and outputs (always required)
        if len(args) - argIndex < 2:
            parser.error("need at least: <rdla/rdlb files> <frames> <output1>")
            return

        self.mNumFrames = int(args[argIndex])
        rawOutputs = args[argIndex + 1:]

        # Parse --wedge-attribute option(s) if specified (for automatic mode).
        # Each occurrence is a 4-tuple: (object-name|sv, attr, min, max). Multiple
        # occurrences animate multiple objects/attributes together in one wedge.
        self.mAnimatedAttrs = []
        if self.mOptions.wedge_attribute:
            for attrParts in self.mOptions.wedge_attribute:
                objectName, attributeName, minValues, maxValues = attrParts

                # Parse min/max values (can be comma-separated for multi-component)
                splitWedgeMinValue = minValues.split(',')
                splitWedgeMaxValue = maxValues.split(',')
                wedgeMinLen = len(splitWedgeMinValue)
                wedgeMaxLen = len(splitWedgeMaxValue)

                if wedgeMinLen != wedgeMaxLen:
                    parser.error("--wedge-attribute: mismatch in number of min/max "
                                 "components for %s %s" % (objectName, attributeName))
                    return
                if wedgeMinLen < 1 or wedgeMinLen > 4:
                    parser.error("--wedge-attribute: min/max must have 1-4 "
                                 "comma-separated components for %s %s" %
                                 (objectName, attributeName))
                    return

                self.mAnimatedAttrs.append({
                    'objectName': objectName,
                    'attrName': attributeName,
                    'minVals': [float(v) for v in splitWedgeMinValue],
                    'maxVals': [float(v) for v in splitWedgeMaxValue],
                    'multiType': None,    # filled in by createModifiedScene()
                    'objectType': None,   # filled in by createModifiedScene()
                })

        # --overlay-wedged-attributes has no attribute name/value to show unless
        # --wedge-attribute was also given (that's what populates mAnimatedAttrs)
        if self.mOptions.overlay_wedged_attributes and not self.mOptions.wedge_attribute:
            parser.error("--overlay-wedged-attributes requires --wedge-attribute " +
                         "(it overlays the name/value set by --wedge-attribute)")
            return

        # Detect and collapse shell-expanded glob patterns back into patterns
        # If the shell expanded "foo.*.exr" into ["foo.0000.exr", "foo.0001.exr", ...],
        # we want to collapse it back to "foo.*.exr"
        import re
        self.mOutputs = []
        processed = set()

        for i, output in enumerate(rawOutputs):
            if i in processed:
                continue

            # Check if this output has a frame number pattern (e.g., .0000., .0001.)
            match = re.match(r'(.*\.)(\d{4})(\..+)$', output)
            if match:
                prefix, frameNum, suffix = match.groups()
                # Check if subsequent outputs are part of the same sequence
                isSequence = False
                for j in range(i + 1, len(rawOutputs)):
                    if re.match(re.escape(prefix) + r'\d{4}' + re.escape(suffix) + '$', rawOutputs[j]):
                        isSequence = True
                        processed.add(j)

                if isSequence:
                    # This is a shell-expanded sequence, collapse it back to a pattern
                    pattern = prefix + '*' + suffix
                    self.mOutputs.append(pattern)
                else:
                    # Just a single file with a number in it
                    self.mOutputs.append(output)
            else:
                # No frame number, keep as-is
                self.mOutputs.append(output)

        # Parse --overlay-static-attributes <object-name|sv> <comma,separated,attrs>
        # option(s). Each occurrence targets one object; repeat the option to show
        # attributes from multiple objects. Independent of --wedge-attribute.
        self.mStaticAttrSpecs = []
        if self.mOptions.overlay_static_attributes:
            for objectName, attrList in self.mOptions.overlay_static_attributes:
                attrNames = [''.join(a.split()) for a in attrList.split(',') if a.strip()]
                if not attrNames:
                    parser.error("--overlay-static-attributes: no attribute names given for %s" %
                                 objectName)
                    return
                self.mStaticAttrSpecs.append({'objectName': objectName, 'attrNames': attrNames})

        # Parse --overlay-expr "LABEL=EXPR" options (repeatable) into (label, expr) tuples.
        self.mOverlayExprs = []
        if self.mOptions.overlay_expr:
            for spec in self.mOptions.overlay_expr:
                if '=' not in spec:
                    parser.error(
                        "--overlay-expr must be of the form LABEL=EXPR, got: %s" % spec)
                    return
                label, expr = spec.split('=', 1)
                self.mOverlayExprs.append((label, expr))

        self.mStaticAttributeValues = {}  # (objectName, attrName) -> formatted value string,
                                           # populated by createModifiedScene()/resolveStaticAttributes()
        self.mObjectGroups = []   # Populated by createModifiedScene(): one entry per distinct
                                  # animated object, each holding that object's type and the
                                  # list of animated-attribute specs targeting it.

    def setup(self):
        """ Create temp dir for sidecar rdla file """

        # Create temp working dir
        self.workDir = '/tmp/rdla_wedge'
        if self.mOptions.clean and os.path.exists(self.workDir):
            shutil.rmtree(self.workDir)
        if not os.path.exists(self.workDir):
            os.makedirs(self.workDir)

        # Create path for sidecar rdla file (will be created in createModifiedScene)
        self.mSidecarRdlaFile = '%s/animation_override.rdla' % self.workDir

    def formatValueAsRdla(self, value, type_name):
        """Format a single API value as an rdla string."""
        if value is None:
            return None

        if type_name == 'Bool':
            return 'true' if value else 'false'
        elif type_name in ['Float', 'Double']:
            return '%.6g' % value
        elif type_name in ['Int', 'Long']:
            return str(int(value))
        elif type_name == 'Rgb':
            return 'Rgb(%.6g, %.6g, %.6g)' % (value.r, value.g, value.b)
        elif type_name == 'Rgba':
            return 'Rgba(%.6g, %.6g, %.6g, %.6g)' % (value.r, value.g, value.b, value.a)
        elif type_name == 'Vec2f' or type_name == 'Vec2d':
            return 'Vec2(%.6g, %.6g)' % (value.x, value.y)
        elif type_name == 'Vec3f' or type_name == 'Vec3d':
            return 'Vec3(%.6g, %.6g, %.6g)' % (value.x, value.y, value.z)
        elif type_name == 'String':
            return '"%s"' % value
        elif type_name == 'SceneObject':
            # Scene object reference - format as ClassName("objectName")
            if hasattr(value, 'getName') and hasattr(value, 'getSceneClass'):
                return '%s("%s")' % (value.getSceneClass().getName(), value.getName())

        return None

    def lookupSceneObject(self, scene_context, objectName):
        """Resolve 'sv' to SceneVariables or look up a named SceneObject
        (material, map, light, camera, geometry, etc.) by name. Exits with
        an error message on failure, consistent with the rest of this tool."""
        if objectName == 'sv':
            try:
                return scene_context.getSceneVariables()
            except Exception as e:
                printError('Could not load SceneVariables: ', str(e))
                sys.exit(1)
        else:
            try:
                api_obj = scene_context.getSceneObject(objectName)
            except Exception as e:
                printError('Could not load SceneObject: ', objectName, ' Error: ', str(e))
                sys.exit(1)
            if api_obj is None:
                printError('Could not find SceneObject: ', objectName)
                sys.exit(1)
            return api_obj

    def createModifiedScene(self):
        """ Create a sidecar rdla file with the animated attribute(s) that overrides
        the input files, and/or resolve any --overlay-static-attributes values.
        Attribute animation (--wedge-attribute) and static attribute overlay
        (--overlay-static-attributes) are independent of each other; either, both,
        or neither may be in effect. """

        needsSceneLoad = bool(self.mOptions.wedge_attribute) or bool(self.mStaticAttrSpecs)
        if not needsSceneLoad:
            printOkGreen('Manual mode (default): global wedge variable will be injected via -rdla_set')
            return

        # Verify all input files exist
        for sourceFile in self.mSourceRdlaFiles:
            if not os.path.exists(sourceFile):
                printError('Input rdla/rdlb file does not exist: ', sourceFile)
                sys.exit(1)

        # Create scene context and load all classes
        scene_context = scene_rdl2.SceneContext()
        scene_context.setProxyModeEnabled(True)
        scene_context.loadAllSceneClasses()

        # Load all source files (later files override earlier ones)
        for sourceFile in self.mSourceRdlaFiles:
            _, ext = os.path.splitext(sourceFile)
            ext = ext.lower()

            try:
                if ext == '.rdlb':
                    reader = scene_rdl2.BinaryReader(scene_context)
                else:
                    reader = scene_rdl2.AsciiReader(scene_context)
                reader.fromFile(sourceFile)
            except Exception as e:
                printError('Failed to load scene file: ', sourceFile, ' Error: ', str(e))
                sys.exit(1)

        if self.mOptions.wedge_attribute:
            self.resolveAnimatedAttributes(scene_context)
            # Now create the sidecar rdla file with the animation
            self.createSidecarFile()
        else:
            printOkGreen('Manual mode (default): global wedge variable will be injected via -rdla_set')

        if self.mStaticAttrSpecs:
            self.resolveStaticAttributes(scene_context)

    def resolveAnimatedAttributes(self, scene_context):
        """Validate each --wedge-attribute target/attribute against the
        scene, determine its object type and multi-component type (for
        sidecar generation), and populate self.mObjectGroups."""

        # Group the animated-attribute specs by target object (preserving the
        # order each object name first appears), so each object gets exactly
        # one sidecar override block even if multiple of its attributes are
        # being animated together.
        self.mObjectGroups = []
        groupByName = {}
        for spec in self.mAnimatedAttrs:
            objectName = spec['objectName']
            group = groupByName.get(objectName)
            if group is None:
                group = {
                    'objectName': objectName,
                    'objectType': None,
                    'attrSpecs': [],
                }
                groupByName[objectName] = group
                self.mObjectGroups.append(group)
            group['attrSpecs'].append(spec)

        for group in self.mObjectGroups:
            objectName = group['objectName']
            attrNames = set(s['attrName'] for s in group['attrSpecs'])
            foundAttrs = set()

            api_obj = self.lookupSceneObject(scene_context, objectName)
            scene_class = api_obj.getSceneClass()
            if objectName != 'sv':
                class_name = scene_class.getName()

                # Store the object type for sidecar file generation
                # Format: ClassName("objectName") - e.g., DwaBaseMaterial("myMaterial")
                group['objectType'] = '%s("%s")' % (class_name, objectName)

            # The sidecar file only needs to override the attribute(s) being
            # animated (loading a scene file merges into the already-loaded
            # SceneObject rather than replacing it, so any attribute left
            # unspecified simply keeps the value it already has). We only
            # need to validate that each requested attribute exists on this
            # object's SceneClass, and note its type for multi-component
            # (Rgb/Vec2/Vec3) wedge-expression generation.
            availableAttrNames = set(scene_class.getAttributeNames())
            for spec in group['attrSpecs']:
                attr_name = spec['attrName']
                if attr_name not in availableAttrNames:
                    continue
                foundAttrs.add(attr_name)

                attr = scene_class.getAttribute(attr_name)
                type_name = attr.getTypeName()

                type_info = WEDGEABLE_ATTR_TYPES.get(type_name)
                if type_info is None:
                    printError('--wedge-attribute: attribute ', attr_name,
                               bcolors.FAIL + ' has unsupported type for wedging: ' + bcolors.ENDC,
                               type_name,
                               bcolors.FAIL + ' (on ' + bcolors.ENDC,
                               ('SceneVariables' if objectName == 'sv' else objectName),
                               bcolors.FAIL + ')' + bcolors.ENDC)
                    sys.exit(1)

                multiType, expectedCount = type_info
                actualCount = len(spec['minVals'])
                if actualCount != expectedCount:
                    printError('--wedge-attribute: attribute ', attr_name,
                               ' is of type ', type_name,
                               bcolors.FAIL + ' (%d component%s)' % (
                                   expectedCount, '' if expectedCount == 1 else 's') + bcolors.ENDC,
                               ', but %d min/max component%s were given' % (
                                   actualCount, '' if actualCount == 1 else 's'))
                    sys.exit(1)

                spec['multiType'] = multiType

            missingAttrs = attrNames - foundAttrs
            if missingAttrs:
                for attrName in sorted(missingAttrs):
                    if objectName == 'sv':
                        printError('Could not find attribute: ',
                                   attrName,
                                   bcolors.FAIL + ' in SceneVariables' + bcolors.ENDC)
                    else:
                        printError('Could not find attribute: ',
                                   attrName,
                                   bcolors.FAIL + ' on SceneObject ' + bcolors.ENDC,
                                   objectName)
                sys.exit(1)

    def resolveStaticAttributes(self, scene_context):
        """Resolve the current value of each attribute requested via
        --overlay-static-attributes. Independent of --wedge-attribute: this
        works whether or not anything is actually being animated."""
        for spec in self.mStaticAttrSpecs:
            objectName = spec['objectName']
            api_obj = self.lookupSceneObject(scene_context, objectName)
            scene_class = api_obj.getSceneClass()
            availableAttrNames = set(scene_class.getAttributeNames())

            for attr_name in spec['attrNames']:
                if attr_name not in availableAttrNames:
                    if objectName == 'sv':
                        printError('Could not find attribute: ', attr_name,
                                   bcolors.FAIL + ' in SceneVariables' + bcolors.ENDC)
                    else:
                        printError('Could not find attribute: ', attr_name,
                                   bcolors.FAIL + ' on SceneObject ' + bcolors.ENDC, objectName)
                    sys.exit(1)

                attr = scene_class.getAttribute(attr_name)
                type_name = attr.getTypeName()
                try:
                    value = api_obj.get(attr_name)
                except Exception:
                    value = None

                attr_value_str = self.formatValueAsRdla(value, type_name) if value is not None else None
                if attr_value_str is None:
                    printError('Could not read/format attribute: ', attr_name,
                               bcolors.FAIL + ' on SceneObject ' + bcolors.ENDC, objectName)
                    sys.exit(1)

                self.mStaticAttributeValues[(objectName, attr_name)] = attr_value_str

    def createSidecarFile(self):
        """Create a sidecar rdla file that overrides the animated attribute(s),
        with one override block per distinct animated object."""

        sidecarContents = []

        # No Lua functions needed - we use the wedge variable directly
        sidecarContents.append('-- Sidecar file for wedge animation')
        sidecarContents.append('-- Uses the "wedge" variable (0-1 with power curve applied)')
        sidecarContents.append('')

        # Add animated attribute(s) using simple interpolation with wedge variable
        # wedge is already normalized [0,1] with power curve applied
        # Formula: minVal + wedge * (maxVal - minVal)

        def makeWedgeExpression(minVal, maxVal):
            """Generate a simplified wedge expression: minVal + wedge * (maxVal - minVal)"""
            range_val = maxVal - minVal

            # Simplify common cases
            if minVal == 0 and range_val == 1:
                return 'wedge'
            elif minVal == 0:
                return '(wedge * %g)' % range_val
            elif range_val == 0:
                return '%g' % minVal
            else:
                return '(%g + wedge * %g)' % (minVal, range_val)

        for group in self.mObjectGroups:
            objectName = group['objectName']

            # Create object definition with the animated attribute(s) as a
            # merge-override (loading this sidecar last merges these values
            # into the already-loaded object; any attribute not mentioned
            # here simply keeps the value it already has from the source
            # file(s), so there's no need to re-state the whole object).
            if objectName == 'sv':
                # SceneVariables override
                sidecarContents.append('SceneVariables() {')
            else:
                # Material or Map override
                if group['objectType']:
                    sidecarContents.append('%s {' % group['objectType'])
                else:
                    printError('Could not determine object type for: ', objectName)
                    sys.exit(1)

            for spec in group['attrSpecs']:
                minVals = spec['minVals']
                maxVals = spec['maxVals']
                multiType = spec['multiType']
                attributeName = spec['attrName']

                if multiType:
                    # Multi-component attribute (Vec2/Vec3/Rgb/Rgba). Component
                    # count was already validated in resolveAnimatedAttributes()
                    # to exactly match this type's expected count, so we can
                    # simply join however many components there are.
                    animStrs = [makeWedgeExpression(minVals[i], maxVals[i])
                                for i in range(len(minVals))]
                    sidecarContents.append('    ["%s"] = %s(%s),' % (
                        attributeName, multiType, ', '.join(animStrs)))
                else:
                    # Single component attribute
                    wedgeExpr = makeWedgeExpression(minVals[0], maxVals[0])
                    sidecarContents.append('    ["%s"] = %s,' % (attributeName, wedgeExpr))

            sidecarContents.append('}')
            sidecarContents.append('')

        # Write the sidecar file
        with open(self.mSidecarRdlaFile, 'w') as f:
            for line in sidecarContents:
                f.write(line)
                f.write('\n')

        printOkGreen('Wrote sidecar rdla: ', self.mSidecarRdlaFile)
        if len(self.mSourceRdlaFiles) > 1:
            printOkBlue('Using %d input files + sidecar (later files override earlier ones)' % len(self.mSourceRdlaFiles))

    def renderScene(self):
        """ Render the scene over the specified duration and add the text overlay"""
        if self.mOptions.skiprender:
            printOkGreen('Skipping rendering')
            return

        # Verify all input files exist before rendering
        for sourceFile in self.mSourceRdlaFiles:
            if not os.path.exists(sourceFile):
                printError('Input rdla/rdlb file does not exist: ', sourceFile)
                sys.exit(1)

        # In automatic mode, verify sidecar file was created
        if self.mOptions.wedge_attribute:
            if not os.path.exists(self.mSidecarRdlaFile):
                printError('Sidecar rdla file was not created: ', self.mSidecarRdlaFile)
                sys.exit(1)

        medianFrameNumber = int(self.mNumFrames / 2)
        startAllRenderTime = time.time()

        # Determine which frames need to be rendered (not copied in pingpong mode)
        frames_to_render = []
        if self.mOptions.pingpong:
            # Only render up to median frame, rest will be copied
            frames_to_render = range(medianFrameNumber + 1)
        else:
            frames_to_render = range(self.mNumFrames)

        # Prepare rendering tasks
        render_tasks = []
        for frameNumber in frames_to_render:
            outputFile = '%s/out.%04d.exr' % (self.workDir, frameNumber)

            # Calculate wedge value - always calculated since we always inject it
            # Calculate wedge value [0,1) or [0,1]
            if self.mOptions.pingpong:
                # In pingpong mode only the first half is rendered; wedge must reach 1.0
                # at the midpoint so the sidecar formula (min + wedge*(max-min)) hits maxVal.
                if medianFrameNumber > 0:
                    wedge_value = float(frameNumber) / float(medianFrameNumber)
                else:
                    wedge_value = 0.0
            elif self.mOptions.inclusive:
                # [0,1] - divide by (num_frames - 1) so the last frame reaches 1.0
                if self.mNumFrames > 1:
                    wedge_value = float(frameNumber) / float(self.mNumFrames - 1)
                else:
                    wedge_value = 0.0
            else:
                # [0,1) - divide by num_frames so the last frame stays below 1.0
                wedge_value = float(frameNumber) / float(self.mNumFrames)

            # Apply power curve
            wedge_value = pow(wedge_value, self.mOptions.power)

            # Prepare text overlay settings if needed (if any text option is enabled)
            text_params = None
            apply_text_overlay = (self.mOptions.overlay_wedged_attributes or self.mOptions.overlay_mcrt or
                                   self.mOptions.overlay_frame or self.mOptions.wedge_label or
                                   self.mOverlayExprs or self.mStaticAttrSpecs)
            if apply_text_overlay:
                text_params = (self.workDir, self.mOptions.textcolor, self.mOptions.textsize,
                             self.mOptions.verbose, self.mOptions.textposition,
                             self.mAnimatedAttrs, self.mStaticAttrSpecs, self.mStaticAttributeValues,
                             wedge_value, self.mOptions.wedge_label, self.mOverlayExprs)

            # Build list of input files
            if self.mOptions.wedge_attribute:
                # Automatic mode: original files + sidecar
                inputFiles = self.mSourceRdlaFiles + [self.mSidecarRdlaFile]
            else:
                # Manual mode: use original files only
                inputFiles = self.mSourceRdlaFiles

            render_tasks.append((frameNumber, inputFiles, outputFile,
                               self.mOptions.exec_mode, self.mOptions.verbose,
                               apply_text_overlay, text_params, self.mOptions.overlay_mcrt,
                               self.mOptions.overlay_frame, self.mOptions.overlay_wedged_attributes,
                               bool(self.mOptions.wedge_attribute), wedge_value))

        # Render frames in parallel
        num_processes = min(self.mOptions.max_concurrent_jobs, multiprocessing.cpu_count())
        printOkBlue('Rendering frames...')
        with multiprocessing.Pool(processes=num_processes) as pool:
            results = pool.map(render_single_frame, render_tasks)

        printOkGreen('Rendering complete.')

        # Check if any renders failed
        failed_frames = [r[0] for r in results if not r[1]]
        if failed_frames:
            printError('Frame rendering failed for frames: ', ', '.join(map(str, failed_frames)))
            return False

        # Handle pingpong frame copying
        if self.mOptions.pingpong:
            printOkBlue('Copying frames for pingpong...')
            for frameNumber in range(medianFrameNumber + 1, self.mNumFrames):
                sourceFrameNumber = medianFrameNumber - (frameNumber - medianFrameNumber)
                sourceFile = '%s/out.%04d.exr' % (self.workDir, sourceFrameNumber)
                outputFile = '%s/out.%04d.exr' % (self.workDir, frameNumber)

                shutil.copy(sourceFile, outputFile)
                if self.mOptions.verbose:
                    printOkGreen('\tCopied frame %d to %d' % (sourceFrameNumber, frameNumber))

        if self.mOptions.verbose:
            print('Total render time: %.2f seconds' % (time.time() - startAllRenderTime))
        print(' ')
        return True

    def processOutputs(self):
        """ Convert rendered frames to an animated gif, mp4, or image sequence"""
        startProcessOutputsTime = time.time()

        # Always use temp directory as source for conversions to avoid issues
        # with output files being picked up on subsequent runs
        outputImages = '%s/out.*.exr' % self.workDir

        # Process each output target
        for outputTarget in self.mOutputs:
            self.convertSingleOutput(outputTarget, outputImages)

        if self.mOptions.verbose:
            print('\tConvert time: %.2f seconds' %
                (time.time() - startProcessOutputsTime))

    def convertSingleOutput(self, outputTarget, outputImages):
        """ Convert rendered frames to a single output target """
        import glob

        # Check if output is an image sequence (contains *)
        isImageSequence = '*' in outputTarget

        if isImageSequence:
            # Handle image sequence output
            printOkBlue('Converting to image sequence: %s' % outputTarget)

            imageFiles = sorted(glob.glob(outputImages))
            if not imageFiles:
                printError('No images found matching: ', outputImages)
                return

            # Parse the output pattern to get directory, base, and extension
            outputPattern = outputTarget
            outputDir = os.path.dirname(outputPattern)
            outputBase = os.path.basename(outputPattern)

            # Create output directory if it doesn't exist
            if outputDir and not os.path.exists(outputDir):
                os.makedirs(outputDir)

            # Extract the extension from the pattern
            outputExt = os.path.splitext(outputBase)[1].lower()

            # Replace * with frame number pattern
            outputBase = outputBase.replace('*', '%04d')

            for i, imgFile in enumerate(imageFiles):
                if outputDir:
                    outputFile = os.path.join(outputDir, outputBase % i)
                else:
                    outputFile = outputBase % i

                # Remove existing output file to prevent ImageMagick from creating numbered variants
                if os.path.exists(outputFile):
                    os.remove(outputFile)

                if outputExt == '.exr':
                    # Just copy the file
                    shutil.copy(imgFile, outputFile)
                    if self.mOptions.verbose:
                        printOkGreen('\tCopied: ', imgFile, ' to ', outputFile)
                else:
                    # Convert to the target format using oiiotool
                    convertCmd = ['oiiotool',
                                 '-i', imgFile,
                                 '--iscolorspace', 'linear',
                                 '--tocolorspace', 'sRGB',
                                 '-o', outputFile]

                    if self.mOptions.verbose:
                        print('\t' + ' '.join(convertCmd))

                    if not runCmd(convertCmd, False):
                        return

                    if self.mOptions.verbose:
                        printOkGreen('\tConverted: ', imgFile, ' to ', outputFile)

            printOkGreen('Wrote image sequence: ', outputPattern)

        else:
            # Get list of source images for both MP4 and GIF
            imageFiles = sorted(glob.glob(outputImages))
            if not imageFiles:
                printError('No images found matching: ', outputImages)
                return

            # Check if output is mp4 or gif
            outputExt = os.path.splitext(outputTarget)[1].lower()
            isMP4 = outputExt == '.mp4'

            if isMP4:
                printOkBlue('Converting to mp4: %s' % outputTarget)
            else:
                printOkBlue('Converting to gif: %s' % outputTarget)

            if isMP4:
                # Use oiiotool to composite over black and convert to PNG, then ffmpeg for MP4
                # Get the base pattern for the image files
                exrPattern = '%s/out.%%04d.exr' % self.workDir

                # Create temp directory for PNG conversions
                tmpPngDir = os.path.join(self.workDir, 'png_frames')
                if not os.path.exists(tmpPngDir):
                    os.makedirs(tmpPngDir)

                # Convert each EXR to PNG with proper alpha handling (in parallel)
                printOkBlue('Converting frames for MP4...')

                # Prepare conversion tasks
                conversion_tasks = []
                for imgFile in imageFiles:
                    frameNum = int(imgFile.split('.')[-2])
                    pngFile = os.path.join(tmpPngDir, 'frame_%04d.png' % frameNum)
                    conversion_tasks.append((imgFile, pngFile, self.mOptions.verbose))

                # Run conversions in parallel
                num_processes = min(self.mOptions.max_concurrent_jobs, multiprocessing.cpu_count())
                with multiprocessing.Pool(processes=num_processes) as pool:
                    results = pool.map(convert_exr_to_png_with_alpha, conversion_tasks)

                # Check if any conversions failed
                if not all(results):
                    printError('One or more frame conversions failed')
                    return

                # Now use ffmpeg to create the MP4 from PNG files
                pngPattern = os.path.join(tmpPngDir, 'frame_%04d.png')

                convertCmd = ['ffmpeg',
                             '-y',  # Overwrite output file
                             '-framerate', '10',  # Input frame rate
                             '-i', pngPattern,
                             '-vf', 'format=yuv420p',
                             '-c:v', 'libx264',
                             '-crf', '18',  # High quality
                             outputTarget]
            else:
                # Use oiiotool to composite over black and convert to PNG, then ffmpeg for GIF
                # Get the base pattern for the image files
                exrPattern = '%s/out.%%04d.exr' % self.workDir

                # Create temp directory for PNG conversions
                tmpPngDir = os.path.join(self.workDir, 'png_frames')
                if not os.path.exists(tmpPngDir):
                    os.makedirs(tmpPngDir)

                # Convert each EXR to PNG with proper alpha handling (in parallel)
                printOkBlue('Converting frames with alpha handling...')

                # Prepare conversion tasks
                conversion_tasks = []
                for imgFile in imageFiles:
                    frameNum = int(imgFile.split('.')[-2])
                    pngFile = os.path.join(tmpPngDir, 'frame_%04d.png' % frameNum)
                    conversion_tasks.append((imgFile, pngFile, self.mOptions.verbose))

                # Run conversions in parallel (limit processes to avoid resource exhaustion)
                num_processes = min(self.mOptions.max_concurrent_jobs, multiprocessing.cpu_count())
                with multiprocessing.Pool(processes=num_processes) as pool:
                    results = pool.map(convert_exr_to_png_with_alpha, conversion_tasks)

                # Check if any conversions failed
                if not all(results):
                    printError('One or more frame conversions failed')
                    return

                # Now use ffmpeg to create the GIF from PNG files with palette generation
                pngPattern = os.path.join(tmpPngDir, 'frame_%04d.png')

                # First pass: generate palette
                paletteFile = os.path.join(self.workDir, 'palette.png')
                paletteCmdCmd = ['ffmpeg',
                                '-y',
                                '-framerate', '10',
                                '-i', pngPattern,
                                '-vf', 'palettegen=max_colors=256:stats_mode=diff',
                                paletteFile]

                if self.mOptions.verbose:
                    print('\tGenerating palette...')
                    print('\t' + ' '.join(paletteCmdCmd))

                if not runCmd(paletteCmdCmd, False):
                    return

                # Second pass: use palette to create GIF
                convertCmd = ['ffmpeg',
                             '-y',
                             '-framerate', '10',
                             '-i', pngPattern,
                             '-i', paletteFile,
                             '-lavfi', '[0:v][1:v]paletteuse=dither=bayer:bayer_scale=5',
                             outputTarget]

            if self.mOptions.verbose:
                print('\t' + ' '.join(convertCmd))

            if not runCmd(convertCmd, False):
                return

            printOkGreen('Wrote: ', outputTarget)

