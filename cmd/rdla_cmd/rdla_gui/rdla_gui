                    default_value_tuple = tuple(default_value.toList())
                else:
                    default_value_tuple = default_value
                control = CustomVec3Control(sub_frame,
                                           default_value_tuple,
                                           initial_value,
                                           command=control_changed)

            elif control_type == "vec2f":
