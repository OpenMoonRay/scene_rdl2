        messagebox.showinfo("No Geometry", "Create a geometry object first.", parent=root)
        return

    dlg = tk.Toplevel(root)
    dlg.title("Add Layer Assignment")
    dlg.transient(root)
    dlg.grab_set()
    dlg.resizable(False, False)

    frame = ttk.Frame(dlg, padding=10)
