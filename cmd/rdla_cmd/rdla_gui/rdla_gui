                def _sov_get_targets(_ri=_sov_required_iface, _self=obj_name):
                    """Return sorted [(cls, name), ...] of all compatible scene objects."""
                    targets = []
                    all_targets = []
                    for (asn, cls, name), _ in object_specs.items():
                        if cls == 'SceneVariables' or not name:
